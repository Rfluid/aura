<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Aura</string>
    <key>CFBundleDisplayName</key>
    <string>Aura</string>
    <key>CFBundleIdentifier</key>
    <string>com.aura.agent-usage</string>
    <key>CFBundleExecutable</key>
    <string>aura</string>
    <key>CFBundleIconFile</key>
    <string>Aura</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!--
        Version strings are substituted by scripts/build-macos-app.sh at
        bundle time from the `aura` crate version; the literal token below
        must remain a single occurrence so the sed replacement stays exact.
    -->
    <key>CFBundleVersion</key>
    <string>__AURA_VERSION__</string>
    <key>CFBundleShortVersionString</key>
    <string>__AURA_VERSION__</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleGetInfoString</key>
    <string>Aura __AURA_VERSION__, © 2026 Rfluid</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Rfluid. Released under the MIT License.</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>

    <!--
        Menu-bar accessory app: no Dock icon, no app-switcher entry.
        Aura also overrides the activation policy in code because GPUI
        forces `Regular` on startup, but keeping this flag set lets
        the launchd agent skip the brief Dock flash on launch.
    -->
    <key>LSUIElement</key>
    <true/>

    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!-- Aura reads ~/.claude/projects/ to count tokens. No camera/mic/file-system prompts. -->
</dict>
</plist>
