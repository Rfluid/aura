[Unit]
Description=Aura — Agent Usage Reporter & Analyzer
Documentation=https://github.com/rfluid/aura
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/aura
# Restart on crash, but respect an explicit "Quit Aura" from the tray
# menu (which exits cleanly with code 0).
Restart=on-failure
RestartSec=5s
# Aura paints to the user's display; inherit the user session environment.
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR XAUTHORITY DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=graphical-session.target
