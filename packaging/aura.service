[Unit]
Description=Aura — Agent Usage Reporter & Analyzer
Documentation=https://github.com/rfluid/aura
# `graphical-session.target` does not wait for the panel to claim
# org.kde.StatusNotifierWatcher, so Aura can (and often does) start before a
# tray host exists. That is handled in-process: the ksni service stays alive
# and registers the icon as soon as a host appears. See
# docs/platform-tray-icon.md § "Surviving a missing StatusNotifier host".
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/aura
# Restart on crash, but respect an explicit "Quit Aura" from the tray
# menu (which exits cleanly with code 0).
Restart=on-failure
RestartSec=5s
# Aura paints to the user's display; inherit the user session environment.
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR XAUTHORITY DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=graphical-session.target
